# ─────────────────────────────────────────────────────────────
# HRMS environment. Copy to `.env` and fill in.
# Secrets are marked ⚿ — never commit real values.
# Catalog is canonical: docs/10-roadmap-testing-deployment.md §4.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=debug

# ── Database (Supabase) ─────────────────────────────────────
# Both strings come from: Supabase dashboard → Connect.
#
# App runtime: Supavisor TRANSACTION mode, port 6543. Every query we
# issue is inside an explicit transaction (see src/lib/db.ts), which is
# exactly what transaction pooling supports. ⚿
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Migrations: Supavisor SESSION mode, port 5432 — same host, different
# port. `prisma migrate` needs advisory locks and session state that
# transaction pooling cannot hold.
#
# The direct endpoint (db.PROJECT_REF.supabase.co:5432) also works, but
# it is IPv6-only unless the project has the IPv4 add-on, which breaks
# migrations from most laptops and from GitHub Actions runners. Session
# mode is IPv4 and avoids the whole question. ⚿
DIRECT_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# ── Auth ────────────────────────────────────────────────────
# 32+ random bytes, base64. Generate: openssl rand -base64 32  ⚿
AUTH_SECRET=

# ── Redis / jobs ────────────────────────────────────────────
# Leave empty to run the queue in the in-process fallback driver
# (jobs execute inline; no retries). Required before Phase 2. ⚿
REDIS_URL=

# ── Object storage (Phase 2) ────────────────────────────────
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Email ───────────────────────────────────────────────────
# console | smtp | resend
EMAIL_PROVIDER=console
EMAIL_FROM="HRMS <no-reply@example.com>"
SMTP_URL=
RESEND_API_KEY=

# ── Scheduled jobs ──────────────────────────────────────────
# Shared secret for /api/v1/cron/*. Vercel Cron sends it as
# `Authorization: Bearer <secret>`. Leave blank and those routes refuse
# every request — they never fall open. 32 random bytes, base64. ⚿
CRON_SECRET=

# ── Crypto (Phase 2: bank account numbers) ──────────────────
# 32 random bytes, base64. ⚿
FIELD_ENCRYPTION_KEY=

# ── Observability ───────────────────────────────────────────
SENTRY_DSN=

# ── Seeding ─────────────────────────────────────────────────
# Pilot company created by `prisma db seed`.
SEED_COMPANY_NAME="Acme Corp"
SEED_COMPANY_SLUG=acme
SEED_ADMIN_EMAIL=admin@example.com
SEED_HR_EMAIL=hr@example.com
# true = also seed sample departments/designations/employees (dev only)
SEED_DEMO=true
