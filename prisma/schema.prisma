// HRMS — canonical schema. Source of truth: docs/04-database.md.
// Scope of this file: Phase 1 M0 + M1 (org, auth/RBAC, people, audit).
// Phase 2 tables (payroll, documents, recruitment, boarding, performance,
// expenses) land in a later migration set — see docs/04-database.md sections 2.6+.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────── enums

enum CompanyStatus {
  active
  suspended

  @@map("company_status")
}

enum UserStatus {
  invited
  active
  disabled

  @@map("user_status")
}

enum TokenKind {
  reset
  invite

  @@map("token_kind")
}

enum Gender {
  male
  female
  other
  undisclosed

  @@map("gender")
}

enum EmploymentType {
  full_time
  part_time
  contract
  intern

  @@map("employment_type")
}

enum PunchDirection {
  in
  out

  @@map("punch_direction")
}

/// Where a punch or a computed record came from. `biometric` is P3; the value
/// exists now so the enum does not need a migration to accept it later.
enum AttendanceSource {
  web
  mobile
  biometric
  manual

  @@map("attendance_source")
}

enum AnnouncementAudience {
  company
  department

  @@map("announcement_audience")
}

enum AccrualFrequency {
  monthly
  yearly
  none

  @@map("accrual_frequency")
}

/// Half-day leave is only meaningful on a single-day request.
enum HalfDayPart {
  none
  first_half
  second_half

  @@map("half_day_part")
}

enum LeaveRequestStatus {
  pending
  approved
  rejected
  cancelled

  @@map("leave_request_status")
}

enum CorrectionStatus {
  pending
  approved
  rejected
  cancelled

  @@map("correction_status")
}

enum AttendanceStatus {
  present
  absent
  half_day
  on_leave
  holiday
  week_off

  @@map("attendance_status")
}

/// Who put a task on somebody's list. The distinction is the whole reason
/// the completion figure can be trusted: work the company asked for and work
/// a person chose for themselves are not the same claim, and averaging them
/// together would let anyone raise their own number by adding easy tasks.
enum JobStatus {
  draft
  open
  on_hold
  closed

  @@map("job_status")
}

enum CandidateSource {
  referral
  portal
  agency
  direct

  @@map("candidate_source")
}

/// Rejection is reachable from any stage, which is why it is a stage rather
/// than a flag: "where did we lose them" is the question a funnel exists to
/// answer.
enum ApplicationStage {
  applied
  screening
  interview
  offer
  hired
  rejected

  @@map("application_stage")
}

enum InterviewMode {
  onsite
  video
  phone

  @@map("interview_mode")
}

enum InterviewRecommendation {
  strong_yes
  yes
  no
  strong_no

  @@map("interview_recommendation")
}

enum OfferStatus {
  draft
  sent
  accepted
  declined
  withdrawn

  @@map("offer_status")
}

enum TaskOrigin {
  assigned
  self

  @@map("task_origin")
}

enum TaskStatus {
  not_started
  in_progress
  completed
  cancelled

  @@map("task_status")
}

enum EmployeeStatus {
  onboarding
  active
  on_notice
  exited

  @@map("employee_status")
}

// ─────────────────────────────────────────────── org

/// Tenant root. Has no company_id — it is the tenant.
model Company {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String        @db.VarChar(160)
  legalName    String?       @map("legal_name") @db.VarChar(200)
  slug         String        @unique @db.VarChar(60)
  logoKey      String?       @map("logo_key") @db.VarChar(255)
  address      String?
  contactEmail String?       @map("contact_email") @db.VarChar(160)
  timezone     String        @default("Asia/Kolkata") @db.VarChar(64)
  currency     String        @default("INR") @db.Char(3)
  status       CompanyStatus @default(active)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz(6)

  locations            Location[]
  departments          Department[]
  designations         Designation[]
  shifts               Shift[]
  employeeShifts       EmployeeShift[]
  punches              AttendancePunch[]
  attendanceRecords    AttendanceRecord[]
  corrections          AttendanceCorrection[]
  users                User[]
  roles                Role[]
  employees            Employee[]
  emergencyContacts    EmergencyContact[]
  systemSettings       SystemSetting[]
  auditLogs            AuditLog[]
  attendanceMonthLocks AttendanceMonthLock[]
  holidays             Holiday[]
  leaveTypes           LeaveType[]
  leavePolicies        LeavePolicy[]
  leaveBalances        LeaveBalance[]
  leaveRequests        LeaveRequest[]
  notifications        Notification[]
  announcements        Announcement[]
  announcementReads    AnnouncementRead[]
  jobTasks             JobTask[]
  jobPostings          JobPosting[]
  candidates           Candidate[]
  applications         Application[]
  interviews           Interview[]
  offers               Offer[]

  @@map("companies")
}

model Location {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  name      String    @db.VarChar(120)
  code      String    @db.VarChar(30)
  address   String?
  /// Falls back to companies.timezone when null.
  timezone  String?   @db.VarChar(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employees   Employee[]
  holidays    Holiday[]
  jobPostings JobPosting[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("locations")
}

model Department {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  name           String    @db.VarChar(120)
  code           String    @db.VarChar(30)
  headEmployeeId String?   @map("head_employee_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  headEmployee  Employee?      @relation("DepartmentHead", fields: [headEmployeeId], references: [id], onDelete: SetNull)
  employees     Employee[]     @relation("EmployeeDepartment")
  announcements Announcement[]
  jobPostings   JobPosting[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("departments")
}

model Designation {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  title     String    @db.VarChar(120)
  code      String    @db.VarChar(30)
  level     Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employees   Employee[]
  jobPostings JobPosting[]
  offers      Offer[]

  @@unique([companyId, code])
  @@index([companyId, level])
  @@map("designations")
}

/// key/value config. company_id NULL = platform-wide default.
model SystemSetting {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String?  @map("company_id") @db.Uuid
  key       String   @db.VarChar(120)
  value     Json
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company       Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  updatedByUser User?    @relation("SettingUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([companyId, key])
  @@index([key])
  @@map("system_settings")
}

// ─────────────────────────────────────────────── auth

model User {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String     @map("company_id") @db.Uuid
  email            String     @db.VarChar(160)
  /// null until the invite is accepted.
  passwordHash     String?    @map("password_hash") @db.VarChar(255)
  status           UserStatus @default(invited)
  /// Bump to invalidate every JWT already issued for this user.
  sessionVersion   Int        @default(1) @map("session_version")
  failedLoginCount Int        @default(0) @map("failed_login_count")
  lockedUntil      DateTime?  @map("locked_until") @db.Timestamptz(6)
  lastLoginAt      DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  company              Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee             Employee?              @relation("EmployeeUser")
  userRoles            UserRole[]             @relation("UserRoleHolder")
  rolesAssigned        UserRole[]             @relation("UserRoleAssignedBy")
  resetTokens          PasswordResetToken[]
  settingsUpdated      SystemSetting[]        @relation("SettingUpdatedBy")
  auditLogs            AuditLog[]             @relation("AuditActor")
  punchesCreated       AttendancePunch[]      @relation("PunchCreatedBy")
  overtimeApproved     AttendanceRecord[]     @relation("OvertimeApprovedBy")
  correctionsReviewed  AttendanceCorrection[] @relation("CorrectionReviewedBy")
  monthLocks           AttendanceMonthLock[]  @relation("MonthLockedBy")
  leavesReviewed       LeaveRequest[]         @relation("LeaveReviewedBy")
  notifications        Notification[]
  announcementsWritten Announcement[]         @relation("AnnouncementAuthor")
  announcementReads    AnnouncementRead[]
  jobTasksAuthored     JobTask[]              @relation("JobTaskAuthor")
  jobPostingsAuthored  JobPosting[]           @relation("JobPostingAuthor")
  offersApproved       Offer[]                @relation("OfferApprover")

  @@unique([companyId, email])
  @@index([companyId, status])
  @@map("users")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  name        String   @db.VarChar(60)
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([companyId, name])
  @@map("roles")
}

/// Global catalog — platform-defined, not tenant-scoped.
model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(80)
  module      String   @db.VarChar(40)
  action      String   @db.VarChar(20)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@map("role_permissions")
}

model UserRole {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedBy String?  @map("assigned_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user           User  @relation("UserRoleHolder", fields: [userId], references: [id], onDelete: Cascade)
  role           Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedByUser User? @relation("UserRoleAssignedBy", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@unique([userId, roleId])
  @@index([userId])
  @@map("user_roles")
}

/// Reset + invite tokens. The raw token is never stored, only its SHA-256.
model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  kind      TokenKind
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ─────────────────────────────────────────────── people

model Employee {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String         @map("company_id") @db.Uuid
  userId           String?        @unique @map("user_id") @db.Uuid
  employeeCode     String         @map("employee_code") @db.VarChar(30)
  firstName        String         @map("first_name") @db.VarChar(80)
  lastName         String?        @map("last_name") @db.VarChar(80)
  workEmail        String?        @map("work_email") @db.VarChar(160)
  personalEmail    String?        @map("personal_email") @db.VarChar(160)
  phone            String?        @db.VarChar(30)
  dateOfBirth      DateTime?      @map("date_of_birth") @db.Date
  gender           Gender?
  address          String?
  photoKey         String?        @map("photo_key") @db.VarChar(255)
  departmentId     String         @map("department_id") @db.Uuid
  designationId    String         @map("designation_id") @db.Uuid
  locationId       String         @map("location_id") @db.Uuid
  managerId        String?        @map("manager_id") @db.Uuid
  employmentType   EmploymentType @map("employment_type")
  status           EmployeeStatus @default(onboarding)
  joinDate         DateTime       @map("join_date") @db.Date
  probationEndDate DateTime?      @map("probation_end_date") @db.Date
  confirmationDate DateTime?      @map("confirmation_date") @db.Date
  exitDate         DateTime?      @map("exit_date") @db.Date
  /// Overrides the company default when set.
  noticePeriodDays Int?           @map("notice_period_days")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?      @map("deleted_at") @db.Timestamptz(6)

  company           Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user              User?                  @relation("EmployeeUser", fields: [userId], references: [id], onDelete: SetNull)
  department        Department             @relation("EmployeeDepartment", fields: [departmentId], references: [id], onDelete: Restrict)
  designation       Designation            @relation(fields: [designationId], references: [id], onDelete: Restrict)
  location          Location               @relation(fields: [locationId], references: [id], onDelete: Restrict)
  manager           Employee?              @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports     Employee[]             @relation("EmployeeManager")
  headOfDepartments Department[]           @relation("DepartmentHead")
  emergencyContacts EmergencyContact[]
  shiftAssignments  EmployeeShift[]
  punches           AttendancePunch[]
  attendance        AttendanceRecord[]
  corrections       AttendanceCorrection[]
  monthLocks        AttendanceMonthLock[]
  leaveBalances     LeaveBalance[]
  leaveRequests     LeaveRequest[]         @relation("LeaveRequester")
  leavesToApprove   LeaveRequest[]         @relation("LeaveApprover")
  jobTasks          JobTask[]
  interviewsPanel   Interview[]            @relation("InterviewPanel")
  hiredFrom         Application?           @relation("ApplicationHire")

  @@unique([companyId, employeeCode])
  @@index([companyId, status])
  @@index([companyId, departmentId])
  @@index([managerId])
  @@map("employees")
}

model EmergencyContact {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  employeeId   String    @map("employee_id") @db.Uuid
  name         String    @db.VarChar(120)
  relationship String    @db.VarChar(60)
  phone        String    @db.VarChar(30)
  isPrimary    Boolean   @default(false) @map("is_primary")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("emergency_contacts")
}

// ─────────────────────────────────────────────── ops

/// Append-only. The app DB role holds INSERT + SELECT only (see RLS migration).
/// No updated_at by design — audit rows are immutable.
/// Working-time rules that attendance calculation evaluates against.
/// docs/04-database.md §2.4.
model Shift {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId               String    @map("company_id") @db.Uuid
  name                    String    @db.VarChar(80)
  code                    String    @db.VarChar(30)
  /// Wall-clock times in the employee location's timezone, not UTC instants.
  startTime               DateTime  @map("start_time") @db.Time(0)
  /// May be earlier than startTime, which means the shift crosses midnight.
  endTime                 DateTime  @map("end_time") @db.Time(0)
  /// Lateness tolerated before a day is marked late.
  graceMinutes            Int       @default(10) @map("grace_minutes")
  /// Worked minutes below this mark the day half-day rather than present.
  halfDayThresholdMinutes Int       @map("half_day_threshold_minutes")
  /// Unpaid, deducted from worked minutes.
  breakMinutes            Int       @default(0) @map("break_minutes")
  /// 0=Sunday … 6=Saturday.
  weekOffDays             Int[]     @default([0, 6]) @map("week_off_days")
  /// New employees are assigned this one. At most one per company.
  isDefault               Boolean   @default(false) @map("is_default")
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt               DateTime? @map("deleted_at") @db.Timestamptz(6)

  company     Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  assignments EmployeeShift[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("shifts")
}

/// Which shift an employee is on, over time. History is preserved rather than
/// overwritten: attendance for a past date must be recomputable against the
/// rules that were in force on that date, not today's.
model EmployeeShift {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  employeeId    String    @map("employee_id") @db.Uuid
  shiftId       String    @map("shift_id") @db.Uuid
  effectiveFrom DateTime  @map("effective_from") @db.Date
  /// NULL means open-ended — the assignment in force until another supersedes it.
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift    Shift    @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  @@index([employeeId, effectiveFrom])
  @@index([companyId])
  @@map("employee_shifts")
}

/// Raw clock events, immutable by design. A wrong punch is superseded by a
/// correction, never edited: the record of what someone actually pressed is
/// the only thing that can settle a payroll dispute.
model AttendancePunch {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String           @map("company_id") @db.Uuid
  employeeId String           @map("employee_id") @db.Uuid
  punchedAt  DateTime         @map("punched_at") @db.Timestamptz(6)
  direction  PunchDirection
  source     AttendanceSource @default(web)
  note       String?          @db.VarChar(255)
  /// Set only for manual entries, so an HR-entered punch is never mistaken
  /// for one the employee made themselves.
  createdBy  String?          @map("created_by") @db.Uuid
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  creator  User?    @relation("PunchCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([companyId, employeeId, punchedAt])
  @@map("attendance_punches")
}

/// One computed row per employee per day. Derived from punches, the shift in
/// force on that date, and (from M3) leave and holidays — so it is always
/// rebuildable and never the source of truth for what was pressed.
model AttendanceRecord {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId          String           @map("company_id") @db.Uuid
  employeeId         String           @map("employee_id") @db.Uuid
  workDate           DateTime         @map("work_date") @db.Date
  status             AttendanceStatus
  source             AttendanceSource @default(web)
  firstIn            DateTime?        @map("first_in") @db.Timestamptz(6)
  lastOut            DateTime?        @map("last_out") @db.Timestamptz(6)
  workedMinutes      Int              @default(0) @map("worked_minutes")
  lateMinutes        Int              @default(0) @map("late_minutes")
  overtimeMinutes    Int              @default(0) @map("overtime_minutes")
  /// Overtime is captured always and paid only once approved (P2 payout).
  overtimeApproved   Boolean          @default(false) @map("overtime_approved")
  overtimeApprovedBy String?          @map("overtime_approved_by") @db.Uuid
  /// Set when the day cannot be trusted as-is — a missing check-out, most often.
  needsReview        Boolean          @default(false) @map("needs_review")
  /// Mirrors the month lock, so a locked day is answerable without a join.
  locked             Boolean          @default(false)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  company    Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  approvedBy User?    @relation("OvertimeApprovedBy", fields: [overtimeApprovedBy], references: [id], onDelete: SetNull)

  @@unique([companyId, employeeId, workDate])
  @@index([companyId, workDate])
  @@index([companyId, workDate, status])
  @@map("attendance_records")
}

/// A regularization request: "I forgot to punch out on Tuesday".
///
/// Approving one does not edit history. It writes `manual` punches for the
/// times asked for and recomputes the day, so the record stays derived and the
/// original punch stream stays intact — which is the whole reason punches are
/// append-only.
model AttendanceCorrection {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String            @map("company_id") @db.Uuid
  employeeId      String            @map("employee_id") @db.Uuid
  workDate        DateTime          @map("work_date") @db.Date
  requestedIn     DateTime?         @map("requested_in") @db.Timestamptz(6)
  requestedOut    DateTime?         @map("requested_out") @db.Timestamptz(6)
  /// For the cases punches cannot express — a day that should read `on_leave`
  /// rather than `absent`. Re-applied on every recompute, so it survives the
  /// nightly rebuild instead of being silently undone by it.
  requestedStatus AttendanceStatus? @map("requested_status")
  reason          String
  status          CorrectionStatus  @default(pending)
  reviewedBy      String?           @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?         @map("reviewed_at") @db.Timestamptz(6)
  reviewNote      String?           @map("review_note")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer User?    @relation("CorrectionReviewedBy", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([employeeId, workDate])
  @@map("attendance_corrections")
}

/// A payroll-safe freeze. Once a month is locked, the attendance it contains
/// stops moving: no punches, no corrections, no recomputation. Payroll is
/// calculated from these numbers, and a number that can still change after
/// payslips are issued is not a number anyone can defend.
model AttendanceMonthLock {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  year      Int
  month     Int
  lockedBy  String   @map("locked_by") @db.Uuid
  lockedAt  DateTime @default(now()) @map("locked_at") @db.Timestamptz(6)
  note      String?

  company    Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user       User      @relation("MonthLockedBy", fields: [lockedBy], references: [id], onDelete: Restrict)
  employee   Employee? @relation(fields: [employeeId], references: [id])
  employeeId String?   @db.Uuid

  @@unique([companyId, year, month])
  @@map("attendance_month_locks")
}

/// Company holiday calendar. A row with no location applies company-wide;
/// one with a location applies only there, which is how a company with
/// offices in two states keeps two different calendars.
model Holiday {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  locationId  String?  @map("location_id") @db.Uuid
  name        String   @db.VarChar(120)
  holidayDate DateTime @map("holiday_date") @db.Date
  isOptional  Boolean  @default(false) @map("is_optional")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  location Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([companyId, locationId, holidayDate, name])
  @@index([companyId, holidayDate])
  @@map("holidays")
}

model LeaveType {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId          String    @map("company_id") @db.Uuid
  name               String    @db.VarChar(80)
  code               String    @db.VarChar(20)
  /// Unpaid leave still consumes a balance; it just does not pay.
  isPaid             Boolean   @default(true) @map("is_paid")
  color              String?   @db.VarChar(9)
  requiresAttachment Boolean   @default(false) @map("requires_attachment")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  policy   LeavePolicy?
  balances LeaveBalance[]
  requests LeaveRequest[]

  @@unique([companyId, code])
  @@map("leave_types")
}

/// One policy per type. A revision overwrites and is audited rather than
/// versioned: a balance already accrued under the old rules is a number, not
/// a rule, so it stays correct without the old rule being kept around.
model LeavePolicy {
  id                       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId                String           @map("company_id") @db.Uuid
  leaveTypeId              String           @unique @map("leave_type_id") @db.Uuid
  accrualFrequency         AccrualFrequency @default(none) @map("accrual_frequency")
  accrualAmount            Decimal          @default(0) @map("accrual_amount") @db.Decimal(5, 2)
  maxCarryForward          Decimal          @default(0) @map("max_carry_forward") @db.Decimal(5, 2)
  /// How far below zero a balance may go. Default 0 means never.
  maxNegative              Decimal          @default(0) @map("max_negative") @db.Decimal(5, 2)
  minNoticeDays            Int              @default(0) @map("min_notice_days")
  maxConsecutiveDays       Int?             @map("max_consecutive_days")
  applicableAfterProbation Boolean          @default(false) @map("applicable_after_probation")
  /// When on, holidays and week-offs *inside* a leave span count as leave.
  /// Adjacent ones never do, which is the whole subtlety of the rule.
  sandwichRule             Boolean          @default(false) @map("sandwich_rule")
  createdAt                DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@map("leave_policies")
}

/// Per employee, per type, per year.
///
/// `current` is deliberately not a column. It is opening + accrued +
/// carriedForward + adjusted - used, and computing it on read means the parts
/// and the total can never disagree, which they eventually will if both are
/// stored and two code paths write them.
model LeaveBalance {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  leaveTypeId    String   @map("leave_type_id") @db.Uuid
  year           Int
  opening        Decimal  @default(0) @db.Decimal(5, 2)
  accrued        Decimal  @default(0) @db.Decimal(5, 2)
  used           Decimal  @default(0) @db.Decimal(5, 2)
  carriedForward Decimal  @default(0) @map("carried_forward") @db.Decimal(5, 2)
  /// Manual HR credit or debit, always with a reason in the audit log.
  adjusted       Decimal  @default(0) @db.Decimal(5, 2)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@unique([companyId, employeeId, leaveTypeId, year])
  @@index([employeeId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String             @map("company_id") @db.Uuid
  employeeId    String             @map("employee_id") @db.Uuid
  leaveTypeId   String             @map("leave_type_id") @db.Uuid
  startDate     DateTime           @map("start_date") @db.Date
  endDate       DateTime           @map("end_date") @db.Date
  halfDay       HalfDayPart        @default(none) @map("half_day")
  /// Working days the request actually costs, computed at submit and frozen.
  /// Recomputing it later would let a holiday added afterwards silently
  /// change what someone already had approved.
  days          Decimal            @db.Decimal(4, 2)
  reason        String
  attachmentKey String?            @map("attachment_key") @db.VarChar(255)
  status        LeaveRequestStatus @default(pending)
  /// The manager resolved at submit time, so a later reorg does not move a
  /// pending request to somebody who never saw it.
  approverId    String?            @map("approver_id") @db.Uuid
  reviewedBy    String?            @map("reviewed_by") @db.Uuid
  reviewedAt    DateTime?          @map("reviewed_at") @db.Timestamptz(6)
  reviewNote    String?            @map("review_note")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee  Employee  @relation("LeaveRequester", fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  approver  Employee? @relation("LeaveApprover", fields: [approverId], references: [id], onDelete: SetNull)
  reviewer  User?     @relation("LeaveReviewedBy", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([employeeId, startDate])
  @@index([approverId, status])
  @@map("leave_requests")
}

/// One row per recipient. Never soft-deleted: a notification is a fact about
/// something that happened, and hiding it is what `read_at` is for.
model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// The domain event key, so a per-event toggle can find its own rows.
  type      String    @db.VarChar(60)
  title     String    @db.VarChar(160)
  body      String
  /// Deep link into the app, so a notification is actionable rather than
  /// merely informative.
  link      String?   @db.VarChar(255)
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

/// An HR broadcast. Unlike a notification this is one row for everybody, with
/// read receipts alongside — fanning a company-wide message out to a row per
/// employee would turn one announcement into a thousand writes.
model Announcement {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String               @map("company_id") @db.Uuid
  title        String               @db.VarChar(160)
  /// Sanitised server-side before it is stored, never on the way out.
  bodyHtml     String               @map("body_html")
  audience     AnnouncementAudience @default(company)
  departmentId String?              @map("department_id") @db.Uuid
  /// Null means drafted but not yet visible to anyone.
  publishedAt  DateTime?            @map("published_at") @db.Timestamptz(6)
  createdBy    String               @map("created_by") @db.Uuid
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?            @map("deleted_at") @db.Timestamptz(6)

  company    Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  department Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  author     User               @relation("AnnouncementAuthor", fields: [createdBy], references: [id], onDelete: Restrict)
  reads      AnnouncementRead[]

  @@index([companyId, publishedAt(sort: Desc)])
  @@map("announcements")
}

model AnnouncementRead {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  announcementId String   @map("announcement_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  readAt         DateTime @default(now()) @map("read_at") @db.Timestamptz(6)

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@map("announcement_reads")
}

/// A unit of work on somebody's month, with a weight and a progress figure.
///
/// This is Module 13's `goals` arriving early and deliberately narrowed
/// (docs/02-modules-talent.md §Module 13). Three differences worth writing
/// down, because they are why this is not simply that table:
///
///   1. `origin` — the blueprint's goals are proposed by the employee and
///      approved by a manager. These may also be assigned outright, which is
///      what makes them usable for measuring what the company asked for.
///   2. `weight` is relative, not a percentage. Percentages that must total
///      100 mean editing three rows to add a fourth, and a weighted average
///      does not care about the scale.
///   3. The period is a plain year and month rather than a review cycle.
///
/// The review half of Module 13 is still unbuilt and would sit alongside.
model JobTask {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String     @map("company_id") @db.Uuid
  employeeId  String     @map("employee_id") @db.Uuid
  /// Who put it there. Null once that account is gone; `origin` still answers
  /// the question that matters.
  createdBy   String?    @map("created_by") @db.Uuid
  origin      TaskOrigin @default(assigned)
  title       String     @db.VarChar(160)
  description String?
  /// Relative importance, 1-100. Two tasks weighted 3 and 1 mean the first is
  /// worth three times the second, and nothing has to add up to anything.
  weight      Int        @default(1)
  /// 0-100. Held separately from `status` because "in progress" says nothing
  /// about how far in.
  progress    Int        @default(0)
  status      TaskStatus @default(not_started)
  /// The month this counts towards. Denormalised rather than derived from a
  /// due date, because a task can be worked in one month and due in the next,
  /// and only one of those is the month it is measured in.
  year        Int
  month       Int
  dueDate     DateTime?  @map("due_date") @db.Date
  completedAt DateTime?  @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  author   User?    @relation("JobTaskAuthor", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([companyId, year, month])
  @@index([employeeId, year, month])
  @@index([companyId, employeeId, status])
  @@map("job_tasks")
}

/// A role we are hiring for.
model JobPosting {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String         @map("company_id") @db.Uuid
  title          String         @db.VarChar(160)
  departmentId   String         @map("department_id") @db.Uuid
  designationId  String         @map("designation_id") @db.Uuid
  locationId     String         @map("location_id") @db.Uuid
  employmentType EmploymentType @map("employment_type")
  openings       Int            @default(1)
  description    String?
  /// Minor units of the company currency, and never shown to a candidate.
  /// Integers because a salary band in floating point is a rounding error
  /// waiting to become an offer.
  salaryMin      BigInt?        @map("salary_min")
  salaryMax      BigInt?        @map("salary_max")
  status         JobStatus      @default(draft)
  closedAt       DateTime?      @map("closed_at") @db.Timestamptz(6)
  createdBy      String?        @map("created_by") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  department   Department    @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  designation  Designation   @relation(fields: [designationId], references: [id], onDelete: Restrict)
  location     Location      @relation(fields: [locationId], references: [id], onDelete: Restrict)
  author       User?         @relation("JobPostingAuthor", fields: [createdBy], references: [id], onDelete: SetNull)
  applications Application[]

  @@index([companyId, status])
  @@map("job_postings")
}

/// A person, not an application. Kept apart so that somebody who was nearly
/// right for one role can be found again for the next one, which is the whole
/// value of a talent pool.
model Candidate {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String          @map("company_id") @db.Uuid
  firstName String          @map("first_name") @db.VarChar(80)
  lastName  String?         @map("last_name") @db.VarChar(80)
  email     String          @db.VarChar(160)
  phone     String?         @db.VarChar(30)
  source    CandidateSource @default(direct)
  /// Object key in storage. The file itself is never public.
  resumeKey String?         @map("resume_key") @db.VarChar(255)
  notes     String?
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  applications Application[]

  @@unique([companyId, email])
  @@index([companyId])
  @@map("candidates")
}

/// One candidate against one job. The same person may apply to several.
model Application {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String           @map("company_id") @db.Uuid
  candidateId     String           @map("candidate_id") @db.Uuid
  jobPostingId    String           @map("job_posting_id") @db.Uuid
  stage           ApplicationStage @default(applied)
  /// Required when the stage is rejected, enforced by a check constraint:
  /// "why did we say no" is the one field everyone skips and everyone later
  /// needs.
  rejectionReason String?          @map("rejection_reason")
  appliedAt       DateTime         @default(now()) @map("applied_at") @db.Timestamptz(6)
  /// Set when an accepted offer becomes a person on the payroll.
  hiredEmployeeId String?          @unique @map("hired_employee_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  company       Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  candidate     Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobPosting    JobPosting  @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  hiredEmployee Employee?   @relation("ApplicationHire", fields: [hiredEmployeeId], references: [id], onDelete: SetNull)
  interviews    Interview[]
  offers        Offer[]

  @@unique([candidateId, jobPostingId])
  @@index([companyId, stage])
  @@map("applications")
}

model Interview {
  id             String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String                   @map("company_id") @db.Uuid
  applicationId  String                   @map("application_id") @db.Uuid
  roundName      String                   @map("round_name") @db.VarChar(80)
  scheduledAt    DateTime                 @map("scheduled_at") @db.Timestamptz(6)
  interviewerId  String                   @map("interviewer_id") @db.Uuid
  mode           InterviewMode            @default(video)
  feedback       String?
  rating         Int?
  recommendation InterviewRecommendation?
  submittedAt    DateTime?                @map("submitted_at") @db.Timestamptz(6)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewer Employee    @relation("InterviewPanel", fields: [interviewerId], references: [id], onDelete: Restrict)

  @@index([companyId, scheduledAt])
  @@index([interviewerId, scheduledAt])
  @@map("interviews")
}

model Offer {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String      @map("company_id") @db.Uuid
  applicationId String      @map("application_id") @db.Uuid
  designationId String      @map("designation_id") @db.Uuid
  /// Minor units, as everywhere money appears.
  ctc           BigInt
  joiningDate   DateTime    @map("joining_date") @db.Date
  expiryDate    DateTime?   @map("expiry_date") @db.Date
  status        OfferStatus @default(draft)
  /// An offer may not be sent until somebody holding recruitment.approve has
  /// signed it off. The gate is this pair of columns rather than a boolean:
  /// who, and when, are both asked about afterwards.
  approvedBy    String?     @map("approved_by") @db.Uuid
  approvedAt    DateTime?   @map("approved_at") @db.Timestamptz(6)
  sentAt        DateTime?   @map("sent_at") @db.Timestamptz(6)
  respondedAt   DateTime?   @map("responded_at") @db.Timestamptz(6)
  notes         String?
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  designation Designation @relation(fields: [designationId], references: [id], onDelete: Restrict)
  approver    User?       @relation("OfferApprover", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@map("offers")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  /// null = system job actor.
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(80)
  entityType  String   @map("entity_type") @db.VarChar(60)
  entityId    String?  @map("entity_id") @db.Uuid
  before      Json?
  after       Json?
  ip          String?  @db.Inet
  userAgent   String?  @map("user_agent") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  actor   User?   @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId, entityType, entityId])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@map("audit_logs")
}
